{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SINator",
  "version": "0.1.0",
  "identifier": "com.sinator.dashboard",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SINator — API Key Pool",
        "width": 500,
        "height": 700,
        "resizable": false,
        "fullscreen": false,
        "url": "/pool-app.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
