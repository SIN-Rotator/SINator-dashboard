{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SINator",
  "version": "0.1.0",
  "identifier": "com.sinator.dashboard",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SINator — Dashboard",
        "width": 1000,
        "height": 750,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["clipboard"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "SINator.entitlements"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
